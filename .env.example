# --- Uzum Seller API (seller.uzum.uz -> Настройки -> API) ---
UZUM_TOKEN=
# Необязательно: id магазина; если пусто — берётся первый из GET /v1/shops
UZUM_SHOP_ID=

# --- МойСклад JSON API 1.2 ---
MS_TOKEN=
# Необязательно: имя организации; если пусто — первая организация аккаунта
MS_ORGANIZATION_NAME=
# Контрагент для заказов Uzum (создаётся автоматически, если не найден)
MS_AGENT_NAME=Uzum Market (покупатель)
# UUID складов (надёжнее имён); если пусто — поиск по имени
MS_STORE_SOURCE_ID=
MS_STORE_UZUM_ID=
MS_STORE_SOURCE_NAME=Фулфилмент Евгений
MS_STORE_UZUM_NAME=Uzum

# --- Интервалы опроса, сек ---
ORDERS_INTERVAL=300
TRANSFERS_INTERVAL=600
STOCK_INTERVAL=3600
# Перекрытие окна опроса заказов, часы (отмены/возвраты приходят позже)
ORDERS_OVERLAP_HOURS=48
# Глубина первой синхронизации заказов, дни (историю не тащим)
ORDERS_INITIAL_DAYS=1
# Накладные старше N дней не синхронизируются
TRANSFERS_INITIAL_DAYS=14
# Сколько дней после выкупа следим за возвратами по заказу
RETURN_WINDOW_DAYS=30

# Автовыравнивание остатков склада «Uzum» (списание/оприходование)
# при расхождении, стабильном две сверки подряд; 0 = только уведомлять
STOCK_AUTOCORRECT=1

# --- Telegram-уведомления об ошибках (пусто = выключено) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Прочее ---
DB_PATH=sync.sqlite3
